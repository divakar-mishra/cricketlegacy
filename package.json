{
  "name": "app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.3.7",
    "@react-navigation/native-stack": "^7.17.9",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.110.1",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.9",
    "expo-asset": "~57.0.8",
    "expo-audio": "~57.0.3",
    "expo-auth-session": "~57.0.10",
    "expo-blur": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.9",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "16.0.3",
    "react-native-purchases": "^10.4.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.1",
    "pngjs": "^3.4.0",
    "prettier": "^3.9.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "generate:portraits": "node scripts/build-portrait-assets.mjs",
    "validate:portraits": "node scripts/build-portrait-assets.mjs --validate-only",
    "normalize:portrait-clothing": "node scripts/normalize-portrait-clothing.mjs --write",
    "validate:portrait-clothing": "node scripts/normalize-portrait-clothing.mjs --check",
    "generate-build-info": "node scripts/writeBuildInfo.js",
    "prestart": "npm run generate-build-info",
    "preandroid": "npm run generate-build-info",
    "preios": "npm run generate-build-info",
    "preweb": "npm run generate-build-info",
    "pretypecheck": "npm run generate-build-info",
    "pretest": "npm run generate-build-info",
    "prelint": "npm run generate-build-info",
    "postinstall": "node scripts/patchGoogleMobileAdsGradle.js && node scripts/writeBuildInfo.js",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watch",
    "audit:five-seasons": "jest --runInBand --testMatch '<rootDir>/scripts/five-season-career-audit.test.ts'",
    "audit:full-careers": "CAREER_AUDIT_FULL=1 jest --runInBand --testMatch '<rootDir>/scripts/five-season-career-audit.test.ts'",
    "audit:monetization-careers": "CAREER_AUDIT_MONETIZATION=1 jest --runInBand --testMatch '<rootDir>/scripts/five-season-career-audit.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:legal-site": "node legal-site/build.mjs",
    "check:legal-site": "node legal-site/build.mjs",
    "check:legal": "node scripts/check-legal-readiness.mjs",
    "check:release": "npm run check:legal && npm run check",
    "eas-build-post-install": "node scripts/eas-build-post-install.mjs",
    "check": "npm run typecheck && npm run lint -- --quiet && npm test -- --runInBand",
    "format": "prettier --write ."
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
