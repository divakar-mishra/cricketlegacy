# Copy only to a local, ignored Supabase function env file or set these with
# `supabase secrets set`. Never prefix server secrets with EXPO_PUBLIC_ and never
# commit real values.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# This explicit kill switch stays false until KYC, both store products,
# RevenueCat mappings, webhook HMAC, migration and sandbox tests are complete.
PREMIUM_SPONSOR_CHECKOUT_ENABLED=false

# RevenueCat v2 secret key with `customer_information:purchases:read` for this
# project. Public mobile SDK keys do not have enough authority for verification.
REVENUECAT_SECRET_API_KEY=sk_your_server_only_revenuecat_key
REVENUECAT_PROJECT_ID=proj000000000000

# Strict mapping from each approved store product identifier to its RevenueCat
# internal Product ID and App ID. `storeProductId` is the identifier delivered
# in webhooks; `revenueCatProductId` is the `prod...` ID returned by API v2.
# Remove a product/store mapping to disable it.
# Replace every placeholder with values copied from the same RevenueCat project.
REVENUECAT_SPONSOR_PRODUCTS_JSON={"player_save_sponsor":{"PLAY_STORE":{"storeProductId":"player_save_sponsor","revenueCatProductId":"prod000000000000","appId":"app000000000000"}},"manager_save_sponsor":{"PLAY_STORE":{"storeProductId":"manager_save_sponsor","revenueCatProductId":"prod111111111111","appId":"app000000000000"}}}

# Begin with SANDBOX only. Add PRODUCTION only after signed release testing.
REVENUECAT_ALLOWED_ENVIRONMENTS=SANDBOX

# Configure this exact Authorization value in the RevenueCat webhook dashboard.
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer replace_with_at_least_24_random_characters

# Enable RevenueCat webhook HMAC and copy its one-time signing secret here.
REVENUECAT_WEBHOOK_HMAC_SECRET=replace_with_at_least_32_random_characters

# Must equal the approved legal.config.json retention.purchaseAuditDays. The
# webhook ledger stores hashes/allowlisted IDs only and is pruned at this age.
PREMIUM_SPONSOR_WEBHOOK_AUDIT_DAYS=365

# Generate independently from all other secrets. The account-deletion function
# must receive the same value so it can preserve non-attributable replay guards.
# Keep it stable for at least the longest approved tombstone or webhook-ledger
# retention. Rotation is allowed only after every old fingerprint expires and
# is pruned, or after a
# versioned multi-pepper comparison is deployed. Existing HMACs cannot be
# re-keyed without the deleted raw transaction IDs. The database deliberately
# rejects a mismatched pepper while any old tombstone or webhook event is live.
PREMIUM_SPONSOR_TRANSACTION_PEPPER=replace_with_a_unique_32_character_random_secret
