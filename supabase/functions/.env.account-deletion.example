# Copy only to a local, ignored Supabase function env file or configure with
# `supabase secrets set`. Never prefix server secrets with EXPO_PUBLIC_ and
# never commit real values.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_project_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Generate independently from every other secret; minimum 32 random characters.
ACCOUNT_DELETION_HMAC_SECRET=replace_with_a_unique_random_secret

# Must equal legal.config.json retention.deletionRequestAuditDays.
ACCOUNT_DELETION_REQUEST_RETENTION_DAYS=30

# Must be the same secret used by all premium-sponsor functions. It creates a
# replay-protection fingerprint without retaining a user/save/brand link. Keep
# it stable until all old tombstone and webhook-ledger fingerprints expire and
# are pruned, unless versioned old+new comparison has been deployed; the
# database rejects mismatches while either kind remains live.
PREMIUM_SPONSOR_TRANSACTION_PEPPER=replace_with_a_different_random_secret

# Must equal legal.config.json retention.purchaseAuditDays.
ACCOUNT_DELETION_PURCHASE_AUDIT_DAYS=365

# Keep both false until RevenueCat is configured. Checkout may never be true
# while customer deletion is false; account deletion fails closed in that state.
PREMIUM_SPONSOR_CHECKOUT_ENABLED=false
REVENUECAT_ANY_IAP_ENABLED=false
REVENUECAT_USES_SUPABASE_UUID_IDENTITY=false
REVENUECAT_CUSTOMER_DELETION_ENABLED=false

# Required only when REVENUECAT_CUSTOMER_DELETION_ENABLED=true. Use a separate
# v2 key limited to `customer_information:customers:read_write`.
REVENUECAT_PROJECT_ID=proj000000000000
REVENUECAT_CUSTOMER_DELETION_SECRET_API_KEY=sk_your_deletion_only_revenuecat_key

# Optional. Every user-owned object must live under `<auth-user-id>/...` inside
# one of these private buckets for the deletion function to discover it.
ACCOUNT_DELETION_STORAGE_BUCKETS=

# Optional; native app requests do not send Origin. Set only if an approved web
# client will call the function directly.
ACCOUNT_DELETION_ALLOWED_ORIGIN=
